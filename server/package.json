{
  "name": "navigation-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "build:city": "tsx src/data/buildCity.ts",
    "build:presets": "tsx src/understand/buildPresetIndex.ts",
    "eval": "tsx src/eval/runEval.ts",
    "eval:check": "tsx src/eval/runEval.ts --check",
    "report:street-tags": "tsx src/data/streetTagReport.ts",
    "report:street-tags-world": "tsx src/data/worldStreetTags.ts",
    "bench:planner": "tsx src/eval/planner/benchPlanner.ts",
    "report:ratings": "tsx src/eval/ratingMean.ts"
  },
  "dependencies": {
    "@openstreetmap/id-tagging-schema": "^7.3.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "openai": "^7.45.1",
    "osm-pbf-parser-node": "^1.1.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
