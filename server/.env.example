OPENAI_API_KEY=
GOOGLE_PLACES_API_KEY=
PORT=3000
CITY=cluj-napoca
LLM_MODEL=gpt-6-luna
# reasoning effort for current models; "none" also allows temperature 0. Leave empty for older models (gpt-4o-mini, gpt-4.1)
LLM_REASONING_EFFORT=none
EMBEDDING_MODEL=text-embedding-3-small
# record | replay | off  (replay = use saved API answers only, for repeatable tests)
API_CACHE=record

# OpenStreetMap street questions ("Is this street lit?"). Register an OAuth 2 app on the OSM server
# (My Settings -> OAuth 2 applications): redirect URI urn:ietf:wg:oauth:2.0:oob, permissions
# "Read user preferences" + "Modify the map", not confidential. Questions are off without a client id.
OSM_CLIENT_ID=
OSM_CLIENT_SECRET=
# test server by default; https://www.openstreetmap.org for real edits
OSM_SERVER=https://master.apis.dev.openstreetmap.org
# on = really upload; anything else = dry run (prepares the change from the live map, writes nothing)
OSM_UPLOAD=off
